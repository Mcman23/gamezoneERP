{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "M\u0259hsulun ad\u0131"
    },
    "category": {
      "type": "string",
      "enum": [
        "yemek",
        "icki",
        "atistirmalik",
        "diger"
      ],
      "description": "Kateqoriya"
    },
    "unit": {
      "type": "string",
      "enum": [
        "piece",
        "gram",
        "portion"
      ],
      "default": "piece",
      "description": "\u00d6l\u00e7\u00fc vahidi"
    },
    "price": {
      "type": "number",
      "description": "Sat\u0131\u015f qiym\u0259ti (AZN)"
    },
    "purchase_price": {
      "type": "number",
      "description": "Al\u0131\u015f qiym\u0259ti (AZN)"
    },
    "in_stock": {
      "type": "boolean",
      "default": true,
      "description": "Stokda var/yox"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0,
      "description": "M\u00f6vcud stok miqdar\u0131"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5,
      "description": "Kritik stok s\u0259viyy\u0259si"
    },
    "image_url": {
      "type": "string",
      "description": "M\u0259hsul \u015f\u0259kli"
    },
    "club_owner_id": {
      "type": "string",
      "description": "Klub sahibinin (admin) ID-si"
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "data.club_owner_id": "{{user.data.club_owner_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "data.club_owner_id": "{{user.data.club_owner_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "data.club_owner_id": "{{user.data.club_owner_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}