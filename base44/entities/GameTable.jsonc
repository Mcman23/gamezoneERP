{
  "name": "GameTable",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Masan\u0131n ad\u0131"
    },
    "code": {
      "type": "string",
      "description": "Unikal kod (PC1, PS1, CabinPS1, Sim1)"
    },
    "category": {
      "type": "string",
      "enum": [
        "computer",
        "playstation",
        "cabinet",
        "simulator"
      ],
      "description": "Kateqoriya"
    },
    "zone": {
      "type": "string",
      "enum": [
        "hall",
        "cabinet"
      ],
      "default": "hall",
      "description": "Zona: Zal v\u0259 ya Kabinet"
    },
    "ps_model": {
      "type": "string",
      "enum": [
        "ps3",
        "ps4",
        "ps5",
        "none"
      ],
      "default": "none",
      "description": "PlayStation modeli"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Saatl\u0131q qiym\u0259t (AZN)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied",
        "locked",
        "maintenance",
        "offline"
      ],
      "default": "available",
      "description": "Masan\u0131n v\u0259ziyy\u0259ti"
    },
    "current_session_id": {
      "type": "string",
      "description": "Cari sessiyan\u0131n ID-si"
    },
    "ip_address": {
      "type": "string",
      "description": "Cihaz\u0131n IP \u00fcnvan\u0131"
    },
    "order_number": {
      "type": "number",
      "default": 0,
      "description": "S\u0131ralama n\u00f6mr\u0259si"
    },
    "club_owner_id": {
      "type": "string",
      "description": "Klub sahibinin (admin) ID-si"
    }
  },
  "required": [
    "name",
    "code",
    "category",
    "hourly_rate"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "data.club_owner_id": "{{user.data.club_owner_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "data.club_owner_id": "{{user.data.club_owner_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}