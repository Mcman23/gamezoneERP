{
  "name": "Session",
  "type": "object",
  "properties": {
    "table_id": {
      "type": "string",
      "description": "Masa ID-si"
    },
    "table_name": {
      "type": "string",
      "description": "Masa ad\u0131"
    },
    "table_category": {
      "type": "string",
      "description": "Masa kateqoriyas\u0131"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Ba\u015flama vaxt\u0131"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Bitm\u0259 vaxt\u0131"
    },
    "duration_minutes": {
      "type": "number",
      "description": "M\u00fcdd\u0259t (d\u0259qiq\u0259)"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Saatl\u0131q qiym\u0259t"
    },
    "session_cost": {
      "type": "number",
      "description": "Sessiya qiym\u0259ti (AZN)"
    },
    "orders_cost": {
      "type": "number",
      "default": 0,
      "description": "Sifari\u015fl\u0259rin \u00fcmumi qiym\u0259ti (AZN)"
    },
    "total_cost": {
      "type": "number",
      "description": "\u00dcmumi m\u0259bl\u0259\u011f (AZN)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "active",
      "description": "Sessiya v\u0259ziyy\u0259ti"
    },
    "paid": {
      "type": "boolean",
      "default": false,
      "description": "\u00d6d\u0259nilib/\u00d6d\u0259nilm\u0259yib"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "mixed"
      ],
      "description": "\u00d6d\u0259ni\u015f \u00fcsulu"
    },
    "is_unlimited": {
      "type": "boolean",
      "default": false,
      "description": "Limitsiz sessiya rejimi"
    },
    "pause_start": {
      "type": "string",
      "format": "date-time",
      "description": "Fasil\u0259 ba\u015flan\u011f\u0131c\u0131"
    },
    "total_paused_minutes": {
      "type": "number",
      "default": 0,
      "description": "\u00dcmumi fasil\u0259 m\u00fcdd\u0259ti"
    },
    "customer_phone": {
      "type": "string",
      "description": "M\u00fc\u015ft\u0259ri telefonu"
    },
    "customer_name": {
      "type": "string",
      "description": "M\u00fc\u015ft\u0259ri ad\u0131"
    },
    "club_owner_id": {
      "type": "string",
      "description": "Klub sahibinin (admin) ID-si"
    }
  },
  "required": [
    "table_id",
    "table_name",
    "start_time",
    "hourly_rate"
  ]
}