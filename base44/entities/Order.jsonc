{
  "name": "Order",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sessiya ID-si"
    },
    "table_id": {
      "type": "string",
      "description": "Masa ID-si"
    },
    "table_name": {
      "type": "string",
      "description": "Masa ad\u0131"
    },
    "items": {
      "type": "array",
      "description": "Sifari\u015f edil\u0259n m\u0259hsullar",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number",
      "description": "\u00dcmumi m\u0259bl\u0259\u011f (AZN)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "description": "Sifari\u015f v\u0259ziyy\u0259ti"
    }
  },
  "required": [
    "session_id",
    "table_id",
    "table_name",
    "items",
    "total_amount"
  ]
}