{
  "name": "Order",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sessiya ID-si"
    },
    "table_id": {
      "type": "string",
      "description": "Masa ID-si"
    },
    "table_name": {
      "type": "string",
      "description": "Masa ad\u0131"
    },
    "items": {
      "type": "array",
      "description": "Sifari\u015f edil\u0259n m\u0259hsullar",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number",
      "description": "\u00dcmumi m\u0259bl\u0259\u011f (AZN)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "description": "Sifari\u015f v\u0259ziyy\u0259ti"
    },
    "club_owner_id": {
      "type": "string",
      "description": "Klub sahibinin (admin) ID-si"
    }
  },
  "required": [
    "session_id",
    "table_id",
    "table_name",
    "items",
    "total_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "data.club_owner_id": "{{user.data.club_owner_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "data.club_owner_id": "{{user.data.club_owner_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.club_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}