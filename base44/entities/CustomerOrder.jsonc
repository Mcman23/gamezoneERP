{
  "name": "CustomerOrder",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sessiya ID"
    },
    "table_id": {
      "type": "string",
      "description": "Masa ID"
    },
    "table_name": {
      "type": "string",
      "description": "Masa ad\u0131"
    },
    "items": {
      "type": "array",
      "description": "Sifari\u015f madd\u0259l\u0259ri",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "seen",
        "delivered"
      ],
      "default": "new"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "table_id",
    "table_name",
    "items",
    "total_amount"
  ]
}